# ==========================================
# PAYLOAD CMS & DATABASE SETTINGS
# ==========================================

# Рядок підключення до бази даних (PostgreSQL)
# Для Vercel Postgres скопіюйте значення змінної POSTGRES_URL
# Приклад: postgres://user:password@ep-name.region.postgres.vercel-storage.com/dbname?sslmode=require
DATABASE_URI=""

# Секретний ключ для Payload CMS (використовується для шифрування сесій)
# Обов'язково замініть на довгий випадковий рядок для продакшену
# Згенерувати можна через термінал: openssl rand -base64 32
PAYLOAD_SECRET="your_secret_key_here_change_me"

# ==========================================
# INTEGRATIONS (Опціонально)
# ==========================================

# Ключ від Resend для відправки email-сповіщень про нові заявки з сайту
# RESEND_API_KEY="re_your_api_key_here"

